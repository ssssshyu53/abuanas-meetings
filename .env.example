APP_ENV=local
SITE_URL=

# Database Driver: mysql (local XAMPP / VPS) OR sqlite (zero-config shared hosting)
DB_DRIVER=mysql
DB_SQLITE_PATH=database/abuanas.sqlite
DB_HOST=127.0.0.1
DB_NAME=abuanas_meetings
DB_USER=root
DB_PASS=

# Shared HS256 secret between Web Backend, Cloudflare Worker & Node.js Relay
JWT_SECRET=replace-with-64-char-random-hex-secret

# Primary Audio Engine (Cloudflare Workers + Durable Objects)
CF_WORKER_WS_URL=

# Failover / Local Audio Relay (Render Node.js or localhost)
NODE_RELAY_WS_URL=ws://127.0.0.1:8788

# Optional Video Engines
CF_SFU_APP_ID=
CF_SFU_APP_SECRET=
HMS_ACCESS_KEY=
HMS_APP_SECRET=
HMS_TEMPLATE_ID=
DAILY_API_KEY=
DAILY_DOMAIN=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=

# Optional Storage & Webhook Publishing
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
